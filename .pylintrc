[MAIN]
# The openeo_fastapi_app package requires optional dependencies (fastapi,
# openeo-fastapi) that are not installed in the standard CI environment.
# Exclude it from lint so the pylint workflow continues to pass.
# overviews/ is vendored in as a git subtree from GeoDN-Discovery/overviews.
# It is upstream research code (notebooks and modules) that is not linted
# upstream, and edits belong there rather than here, so it is excluded.
#
# Both exclusions must use ignore-paths rather than plain `ignore`: the pylint
# workflow passes explicit file paths (pylint $(git ls-files '*.py')), and
# `ignore` is only honoured while recursing into directories, so it had no
# effect on either path in CI.
ignore-paths=^openeo_fastapi_app/.*$|^overviews/.*$

[MESSAGES CONTROL]
# Keep the existing project suppressions intact.
disable=C0114,  # missing-module-docstring
        C0115,  # missing-class-docstring
        C0116,  # missing-function-docstring – widely suppressed in this project
        R0903,  # too-few-public-methods
        W0613   # unused-argument

[FORMAT]
max-line-length=100
